# Copy this file to study-toolkit/.env.local and fill in your keys.

# Gemini API key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpAPI key (web search for past exams): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Gemini model used for syllabus analysis, question extraction and flashcards
GEMINI_MODEL=gemini-3.8-flash
